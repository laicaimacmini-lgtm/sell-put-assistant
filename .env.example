# Local API proxy configuration. Never commit real secrets.
# Provider priority for this personal project:
# mock -> alphavantage -> marketdata -> tradier (optional; requires Tradier Brokerage/API access)
OPTIONS_DATA_PROVIDER=mock
PORT=8787

# Provider tokens are server-side only. Leave blank until configured locally.
ALPHAVANTAGE_API_KEY=
MARKETDATA_TOKEN=
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
ALPACA_KEY=
ALPACA_SECRET=
